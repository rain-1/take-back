<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/tb_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Step 1: nickname (the standalone lobby; a call from a chat skips it) -->
        <LinearLayout
            android:id="@+id/nickStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_nickname"
                android:textColor="@color/tb_muted" />

            <EditText
            style="@style/TbInput"
                android:id="@+id/nickInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. river"
                android:inputType="text"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/nickBtn"
        style="@style/TbButtonPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cont" />
        </LinearLayout>

        <!-- Step 2: lobby -->
        <LinearLayout
            android:id="@+id/lobbyStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/hostBtn"
        style="@style/TbButtonPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/host_call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join_with_code"
                android:textColor="@color/tb_muted"
                android:paddingTop="12dp" />

            <EditText
            style="@style/TbInput"
                android:id="@+id/joinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ABCD12"
                android:inputType="textCapCharacters"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/joinBtn"
        style="@style/TbButtonPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join" />
        </LinearLayout>

        <!-- Step 3: call -->
        <LinearLayout
            android:id="@+id/callStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/callHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/callCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/tb_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/copyBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copy" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connecting"
                android:textColor="@color/tb_muted" />

            <!-- Devices & preferences: set once and keep. -->
            <LinearLayout
                android:id="@+id/settingsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:background="@color/tb_panel_alt">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_source"
                    android:textColor="@color/tb_muted"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/audioSelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mic_level"
                    android:textColor="@color/tb_muted"
                    android:textSize="12sp"
                    android:paddingTop="8dp" />

                <!-- Live level of what peers hear (post-gain). -->
                <ProgressBar
                    android:id="@+id/micMeter"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/micGain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="200"
                        android:progress="100" />

                    <TextView
                        android:id="@+id/micGainVal"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="@color/tb_muted"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/volumes"
                    android:textColor="@color/tb_muted"
                    android:textSize="12sp"
                    android:paddingTop="8dp" />

                <LinearLayout
                    android:id="@+id/volumes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/camera"
                    android:textColor="@color/tb_muted"
                    android:textSize="12sp"
                    android:paddingTop="8dp" />

                <Spinner
                    android:id="@+id/cameraSelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/video_quality"
                    android:textColor="@color/tb_muted"
                    android:textSize="12sp"
                    android:paddingTop="8dp" />

                <Spinner
                    android:id="@+id/videoQualitySelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <CheckBox
                    android:id="@+id/mirrorChk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mirror_my_video"
                    android:textColor="@color/tb_text"
                    android:paddingTop="8dp" />

                <CheckBox
                    android:id="@+id/stereoChk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transmit_stereo"
                    android:textColor="@color/tb_text"
                    android:paddingTop="4dp" />

                <CheckBox
                    android:id="@+id/fillChk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/crop_video_to_fill"
                    android:textColor="@color/tb_text"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mirror_note"
                    android:textColor="@color/tb_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/videoGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="8dp" />

            <!-- Leave sits outside the scrolling row, so ending a call is always
                 one tap away however many other buttons there are. -->
            <LinearLayout
                android:id="@+id/callControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/settingsBtn"
                    style="@style/CallIcon"
                    android:contentDescription="Devices and preferences"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/tb_text"
                    android:src="@drawable/ic_settings" />

                <ImageButton
                    android:id="@+id/micBtn"
                    style="@style/CallIcon"
                    android:contentDescription="Mute microphone"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/tb_text"
                    android:src="@drawable/ic_mic_on" />

                <ImageButton
                    android:id="@+id/camBtn"
                    style="@style/CallIcon"
                    android:contentDescription="Turn camera off"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/tb_text"
                    android:src="@drawable/ic_camera" />

                <ImageButton
                    android:id="@+id/shareBtn"
                    style="@style/CallIcon"
                    android:contentDescription="Present your screen"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/tb_text"
                    android:src="@drawable/ic_present" />

                <ImageButton
                    android:id="@+id/flipBtn"
                    style="@style/CallIcon"
                    android:contentDescription="Flip camera"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/tb_text"
                    android:src="@drawable/ic_flip_camera" />

            </LinearLayout>
            </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/leaveBtn"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="2dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/leave"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_leave_call" />
            </LinearLayout>


        </LinearLayout>
    </LinearLayout>
</ScrollView>
