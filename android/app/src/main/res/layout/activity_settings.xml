<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tb_bg"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/server_settings"
        android:textColor="@color/tb_text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/server_hint"
        android:textColor="@color/tb_muted"
        android:textSize="13sp"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_picture"
        android:textColor="@color/tb_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/avatarPreview"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/setAvatarBtn"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_picture" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/server_url"
        android:textColor="@color/tb_muted"
        android:textSize="12sp" />

    <EditText
            style="@style/TbInput"
        android:id="@+id/serverUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://takeback.chain-of-thought.org"
        android:textColor="@color/tb_text"
        android:textColorHint="@color/tb_dim"
        android:inputType="textUri"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tb_danger"
        android:textSize="13sp"
        android:minHeight="20dp"
        android:paddingTop="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/resetBtn"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/use_default" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/saveBtn"
        style="@style/TbButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/server_note"
        android:textColor="@color/tb_dim"
        android:textSize="12sp"
        android:paddingTop="18dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/tb_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:text="Messages while the app is closed"
        android:textColor="@color/tb_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:text="take-back checks periodically while closed. Android may defer checks to save battery, so messages can arrive up to about 15 minutes late."
        android:textColor="@color/tb_muted"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/stayConnected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Background message checks"
        android:textColor="@color/tb_text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:text="This account"
        android:textColor="@color/tb_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/settingsWho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="10dp"
        android:textColor="@color/tb_muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/logoutBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/log_out" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="22dp"
        android:text="Version"
        android:textColor="@color/tb_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/settingsVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="@color/tb_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/versionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/updateBtn"
        style="@style/HeaderAction"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:text="Download the update" />
</LinearLayout>
