<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- App theme mapped onto the web palette. Dark, accent-blue, rounded. -->
    <style name="Theme.TakeBack" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/tb_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/tb_accent</item>
        <item name="android:colorBackground">@color/tb_bg</item>
        <item name="colorSurface">@color/tb_panel</item>
        <item name="colorOnSurface">@color/tb_text</item>
        <item name="colorOnBackground">@color/tb_text</item>
        <item name="android:statusBarColor">@color/tb_panel</item>
        <item name="android:windowBackground">@color/tb_bg</item>
        <item name="materialButtonStyle">@style/TbButton</item>
    </style>

    <!-- Buttons, like the web client's: quiet by default — a panel with a
         border — so a screen full of them isn't a wall of accent blue. -->
    <style name="TbButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/tb_surface2</item>
        <item name="strokeColor">@color/tb_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/tb_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- The one action a screen is really for: log in, save. -->
    <style name="TbButtonPrimary" parent="TbButton">
        <item name="backgroundTint">@color/tb_accent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- The small action beside a section heading: muted, no chrome, like the
         rest of the app rather than a bright accent button. -->
    <style name="HeaderAction" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/tb_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- A round call control: the phone's version of the web tray's icons. -->
    <style name="CallIcon" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/bg_call_icon</item>
        <!-- Material3 inflates <Button> as MaterialButton, which paints
             backgroundTint over android:background — that's what made these
             accent blue instead of the muted circle. -->
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/tb_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- An icon-only action beside a heading. Material3 inflates <Button> as
         MaterialButton, which silently drops android:drawable* — so these are
         ImageButtons, tinted muted rather than accent. -->
    <style name="HeaderIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/tb_muted</item>
    </style>

    <!-- Text fields across the app: the same rounded panel as the web client's,
         instead of Material's bright accent underline. -->
    <style name="TbInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/tb_text</item>
        <item name="android:textColorHint">@color/tb_dim</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources>
